<DrawerPage
    x:Class="OceanApocalypse.Wave.IDE.UI.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OceanApocalypse.Wave.IDE.UI.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    Header="Avalonia"
    mc:Ignorable="d">
    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!--  Define your drawer header here  -->
    <DrawerPage.DrawerHeader>
        <DockPanel Margin="10" LastChildFill="True">
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                DockPanel.Dock="Bottom"
                FontSize="16">
                Avalonia
            </Label>
            <Image
                Width="150"
                Margin="10"
                Source="/Assets/Icon.png"
                Stretch="Uniform" />
        </DockPanel>
    </DrawerPage.DrawerHeader>

    <!--  Define your drawer footer here  -->
    <DrawerPage.DrawerFooter>
        <Grid Margin="10">
            <Label HorizontalAlignment="Center">Avalonia</Label>
        </Grid>
    </DrawerPage.DrawerFooter>
    <DrawerPage.Drawer>
        <ListBox
            Name="DrawerList"
            SelectionChanged="DrawerList_SelectionChanged"
            SelectionMode="AlwaysSelected">
            <ListBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <PathIcon Data="{StaticResource HomeIcon}" />
                    <Label
                        Padding="0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="16">
                        Home
                    </Label>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <PathIcon Data="{StaticResource SettingsIcon}" />
                    <Label
                        Padding="0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="16">
                        Settings
                    </Label>
                </StackPanel>
            </ListBoxItem>
        </ListBox>
    </DrawerPage.Drawer>
    <ContentPage Name="ContentPage">
        <ContentPage.DataTemplates>
            <DataTemplate x:DataType="vm:HomeViewModel">
                <ContentPage Header="Home">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource HomeIcon}" />
                    </ContentPage.Icon>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Welcome To Avalonia" />
                </ContentPage>
            </DataTemplate>
            <DataTemplate x:DataType="vm:SettingsViewModel">
                <ContentPage Header="Home">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource SettingsIcon}" />
                    </ContentPage.Icon>
                    <TextBox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding Greeting}" />
                </ContentPage>
            </DataTemplate>
        </ContentPage.DataTemplates>
    </ContentPage>
</DrawerPage>