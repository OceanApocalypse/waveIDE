{
	// no plugin, urls or perms can be here

	// Defines the compatibility contract - if the section is fully omitted, it's assumed the plugin wasn't tested in a single editor
	"compatibility": {
		// apiVersion must still be here
		"apiVersion": "3",

		// editors where the compatibility with the plugin is known to exist - tested
		// it's the editor that enforces this policy
		// all the SDK does is clean up and interpret 'a:b' syntax
		"compatibleEditors": [
			// the following syntax reference is specific to waveIDE
			"waveIDE", // targetting all versions for an editor
			"waveIDE:*", // same as above
			"waveIDE:3", // specific major version
			"waveIDE:3-1", // major version ranges
			"waveIDE:3.0", // specific minor versions
			"waveIDE:3.0.1", // specific patch versions
			"waveIDE:2-", // every version until a given one (included),
			"waveIDE:3.0.1-/",
			"waveIDE:3.1-2.9.0", // minor and patch ranges
			"waveIDE:2026", // year (any version dating '26 is compatible)
			"waveIDE:latest" // latest version
		],

		// editors where the compatibility with the plugin is known to not exist - tested
		"incompatibleEditors": [
			// same syntax applies
			"waveIDE:beta"
		],

		// defaults to false (if set to true, any editor not in 'compatible' is automatically incompatible)
		// if set to false, editors not in 'compatible' are considered compatible, but untested
		// it's up to the editor to decide whether something untested should try to run or straight up be disabled
		"unspecifiedAreStrictlyIncompatible": true
	},

	// the executable which serves as the plugin's entry point
	"entryPoint": "bin/sdk3/any/b.out"

	// themes, locales and languages can be added and those are assumed to be a superset of the already defined in the shared manifest
}
